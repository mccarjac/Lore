{
  "name": "lore",
  "version": "1.0.0",
  "//main": "Lore's own Expo entry. Consumers never see it — `exports` below takes precedence for package resolution — so the dev app and the published library can coexist without moving the app shell into example/.",
  "main": "index.ts",
  "//exports": "Two entry points: '.' is the app (LoreApp and everything behind it), './ruleset' is the engine without React Native — see src/headless.ts for why. Nothing else is published, so `lore/lib/utils/...` cannot become anyone's dependency.",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./ruleset": {
      "types": "./lib/headless.d.ts",
      "default": "./lib/headless.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./lib/index.d.ts",
  "//files": "`src` ships so the declaration maps resolve to real sources; `src/rulesets` is excluded for the same reason `tsconfig.build.json` excludes it — the engine package ships the engine, not somebody's campaign (and its map PNG is most of the tarball).",
  "files": [
    "lib",
    "src",
    "!src/rulesets",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mccarjac/Lore.git"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --go --android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "lint:errors": "eslint . --ext .ts,.tsx,.js,.jsx --quiet",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "check-all": "npm run type-check && npm run lint && npm run format:check && npm test",
    "build": "rm -rf lib && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "//prepare": "npm runs this for git dependencies, so a consumer's `npm ci` builds the library with no extra step. husky exits 0 with a warning when there is no .git, which is exactly the case inside node_modules.",
    "prepare": "husky install && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@octokit/rest": "^22.0.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "^5.2.0",
    "@react-native-picker/picker": "^2.11.4",
    "@react-navigation/bottom-tabs": "^7.6.0",
    "@react-navigation/drawer": "^7.7.0",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/native-stack": "^7.3.28",
    "@react-navigation/stack": "^7.4.10",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "@types/react": "~19.1.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "^54.0.6",
    "buffer": "^6.0.3",
    "d3-force": "^3.0.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "expo": "~54.0.0",
    "expo-dev-client": "~6.0.16",
    "expo-document-picker": "~14.0.7",
    "expo-file-system": "~19.0.17",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "^15.0.7",
    "expo-sharing": "~14.0.7",
    "expo-status-bar": "~3.0.8",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-expo": "^54.0.14",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "process": "^0.11.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-gifted-charts": "^1.4.64",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "~4.1.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-svg-web": "^1.0.9",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "react-native-worklets-core": "^1.6.2",
    "react-native-zip-archive": "^7.0.2",
    "readable-stream": "^4.7.0",
    "ts-jest": "^29.4.6",
    "tsc-alias": "^1.9.1",
    "typescript": "~5.9.2",
    "uuid": "^13.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "private": true,
  "peerDependencies": {
    "@octokit/rest": "^22.0.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "^5.2.0",
    "@react-native-picker/picker": "^2.11.4",
    "@react-navigation/drawer": "^7.7.0",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/stack": "^7.4.10",
    "buffer": "^6.0.3",
    "d3-force": "^3.0.0",
    "expo": "~54.0.0",
    "expo-document-picker": "~14.0.7",
    "expo-file-system": "~19.0.17",
    "expo-image-picker": "~17.0.8",
    "expo-sharing": "~14.0.7",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-gifted-charts": "^1.4.64",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "~4.1.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-zip-archive": "^7.0.2",
    "uuid": "^13.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-zip-archive": {
      "optional": true
    },
    "@octokit/rest": {
      "optional": true
    }
  }
}
