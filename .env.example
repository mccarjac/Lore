# App identity — copy to `.env` and edit. Every value has a Lore default in
# `src/branding.ts`, so an untouched clone builds and runs without this file.
#
# `EXPO_PUBLIC_*` values are inlined into the app bundle by Expo's babel
# transform; the unprefixed ones are read only by `app.config.ts` under Node
# and never ship.

# Display name, shown by the OS and used by rulesets for `branding.appName`.
EXPO_PUBLIC_APP_NAME=Lore

# Expo slug. Changing this on an existing project orphans EAS builds.
EXPO_PUBLIC_APP_SLUG=lore

EXPO_PUBLIC_APP_VERSION=1.0.0

# Shared by the iOS bundle identifier and the Android package. Changing this
# on a published app orphans every installed copy.
EXPO_PUBLIC_BUNDLE_IDENTIFIER=com.mccarjac.lore

EXPO_PUBLIC_SPLASH_BACKGROUND_COLOR=#ffffff

# Run `eas init` once for this repo and paste the id it prints here. Only EAS
# builds read it; leaving it empty is fine until you run one.
EAS_PROJECT_ID=

# The Expo account that owns the project.
EXPO_OWNER=mccarjac

# The shared GitHub repository the app syncs campaign data with. Defaults to
# the data library this code shipped against; a different deployment points
# these at its own repo. Read by src/utils/gitIntegration.ts.
EXPO_PUBLIC_DATA_REPO_OWNER=mccarjac
EXPO_PUBLIC_DATA_REPO_NAME=AWInvestigationsDataLibrary
EXPO_PUBLIC_DATA_REPO_BRANCH=main
